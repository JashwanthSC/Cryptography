#include <stdio.h>
#include <string.h>

int main() {
    char text[100];
    int count[26] = {0}, i, max = 0, second = 0;

    printf("Enter ciphertext: ");
    scanf("%s", text);

    for(i = 0; text[i] != '\0'; i++)
        count[text[i] - 'A']++;

    for(i = 0; i < 26; i++) {
        if(count[i] > count[max]) {
            second = max;
            max = i;
        }
    }

    printf("Most frequent letter: %c\n", max + 'A');
    printf("Second possible letter: %c\n", second + 'A');

    return 0;
}
