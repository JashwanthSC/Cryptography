#include <stdio.h>
#include <string.h>

int main() {
    char key[] = "CIPHER";
    char alpha[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    char cipher[27];
    int used[26] = {0}, i, j = 0;

    for(i = 0; key[i] != '\0'; i++) {
        int x = key[i] - 'A';
        if(!used[x]) {
            cipher[j++] = key[i];
            used[x] = 1;
        }
    }

    for(i = 0; i < 26; i++)
        if(!used[i])
            cipher[j++] = alpha[i];

    cipher[26] = '\0';

    printf("Cipher alphabet: %s\n", cipher);

    return 0;
}
