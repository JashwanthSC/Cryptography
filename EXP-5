#include <stdio.h>

int main() {
    char text[100], c;
    int a, b, p, i;

    printf("Enter text: ");
    scanf("%s", text);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    for(i = 0; text[i] != '\0'; i++) {
        p = text[i] - 'A';
        c = (a * p + b) % 26 + 'A';
        printf("%c", c);
    }

    return 0;
}
