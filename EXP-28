#include <stdio.h>

int power(int a, int b, int q) {
    int r = 1;
    while(b--)
        r = (r * a) % q;
    return r;
}

int main() {
    int a = 5, q = 23;
    int x = 6, y = 15;
    int A, B, K1, K2;

    A = power(a,x,q);
    B = power(a,y,q);

    K1 = power(B,x,q);
    K2 = power(A,y,q);

    printf("Alice sends: %d\n", A);
    printf("Bob sends  : %d\n", B);
    printf("Alice key   : %d\n", K1);
    printf("Bob key     : %d\n", K2);

    return 0;
}
