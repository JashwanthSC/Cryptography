#include <stdio.h>
#include <string.h>

int main() {
    char text[100], key[100], cipher[100];
    int i, n;

    printf("Enter plaintext: ");
    scanf("%s", text);

    printf("Enter key: ");
    scanf("%s", key);

    n = strlen(text);

    for(i = 0; i < n; i++)
        cipher[i] = ((text[i]-'A') + (key[i%strlen(key)]-'A')) % 26 + 'A';

    cipher[n] = '\0';

    printf("Ciphertext: %s", cipher);

    return 0;
}
