#include <stdio.h>
#include <string.h>

int main() {
    char text[100], out[100];
    int i, x, y, a, b;

    int k[2][2] = {{9,4},{5,7}};

    printf("Enter plaintext: ");
    scanf("%s", text);

    for(i = 0; i < strlen(text); i += 2) {
        x = text[i] - 'a';
        y = text[i+1] - 'a';

        a = (9*x + 4*y) % 26;
        b = (5*x + 7*y) % 26;

        out[i] = a + 'a';
        out[i+1] = b + 'a';
    }

    out[i] = '\0';

    printf("Ciphertext: %s", out);

    return 0;
}
