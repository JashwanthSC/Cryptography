#include <stdio.h>
#include <string.h>

int main() {
    char text[] = "SENDMOREMONEY";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    int i, c;

    printf("Ciphertext: ");

    for(i = 0; text[i] != '\0'; i++) {
        c = ((text[i]-'A') + key[i]) % 26;
        printf("%c", c + 'A');
    }

    return 0;
}
