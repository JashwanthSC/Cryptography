#include <stdio.h>

int main() {
    char text[500];
    int count[256] = {0}, i;

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    for(i = 0; text[i] != '\0'; i++)
        count[(unsigned char)text[i]]++;

    printf("\nCharacter Frequencies:\n");

    for(i = 0; i < 256; i++)
        if(count[i] > 0)
            printf("%c : %d\n", i, count[i]);

    return 0;
}
