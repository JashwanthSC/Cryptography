#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main() {
    char key[50], text[100], matrix[25], used[26] = {0};
    int i, j, k = 0, r1, c1, r2, c2;
    scanf("%s", key);
    scanf("%s", text);
    for (i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';
        if (!used[ch - 'A']) {
            matrix[k++] = ch;
            used[ch - 'A'] = 1;
        }
    }
    for (i = 0; i < 26; i++) {
        if (i == 9) continue;
        if (!used[i]) {
            matrix[k++] = 'A' + i;
            used[i] = 1;
        }
    }
    for (i = 0; text[i] != '\0'; i++)
        text[i] = toupper(text[i]);
    for (i = 0; text[i] != '\0'; i += 2) {
        char a = text[i];
        char b = text[i + 1];

        if (a == 'J') a = 'I';
        if (b == 'J') b = 'I';

        for (j = 0; j < 25; j++) {
            if (matrix[j] == a) {
                r1 = j / 5;
                c1 = j % 5;
            }
            if (matrix[j] == b) {
                r2 = j / 5;
                c2 = j % 5;
            }
        }
        if (r1 == r2) {
            a = matrix[r1 * 5 + (c1 + 1) % 5];
            b = matrix[r2 * 5 + (c2 + 1) % 5];
        } else if (c1 == c2) {
            a = matrix[((r1 + 1) % 5) * 5 + c1];
            b = matrix[((r2 + 1) % 5) * 5 + c2];
        } else {
            a = matrix[r1 * 5 + c2];
            b = matrix[r2 * 5 + c1];
        }
        printf("%c%c", a, b);
    }
    return 0;
}
